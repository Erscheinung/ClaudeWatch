// Debug-only base configuration for the Watch app target.
// Optionally includes the gitignored repo-root .env. Its KEY = value lines are
// valid xcconfig, but it must not contain "#" comment lines (xcconfig treats them
// as preprocessor directives and the build fails). The token is exposed to Info.plist
// preprocessing as CW_DEV_TODOIST_TOKEN. Without .env the value is empty and nothing
// is seeded. Release does not use this file, so Release bundles never carry the token.
#include? "../../.env"
CW_DEV_TODOIST_TOKEN = $(TODOIST_API_TOKEN)
